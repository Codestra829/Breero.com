APP_ENV=development
APP_NAME=BREERO API
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://breero:breero@postgres:5432/breero
REDIS_URL=redis://redis:6379/0
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ENABLED=false
SCHEDULING_ENABLED=true
AUTOMATIC_BOOKING_ENABLED=false
AUTOMATIC_PROVIDER_ASSIGNMENT_ENABLED=false
PAID_LEADS_ENABLED=false
PAYOUT_ENABLED=false
EMAIL_DELIVERY_URL=
EMAIL_DELIVERY_API_KEY=
GEOCODING_API_KEY=
ODOO_URL=
ODOO_DATABASE=
ODOO_USERNAME=
ODOO_API_KEY=
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
SMS_PROVIDER=
SMS_API_KEY=
PAYOUT_PROVIDER=
PAYOUT_API_KEY=
CORS_ORIGINS=http://localhost:3000
METRICS_ENABLED=true

# Browser-safe frontend configuration. Never place secrets in NEXT_PUBLIC_*.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_API_MODE=live
NEXT_PUBLIC_API_TIMEOUT_MS=12000
