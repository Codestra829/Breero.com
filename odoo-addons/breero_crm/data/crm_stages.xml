<odoo noupdate="1">
  <record id="stage_customer_new" model="crm.stage"><field name="name">New Intake</field><field name="sequence">1</field><field name="team_ids" eval="[(4, ref('team_customer_requests'))]"/></record>
  <record id="stage_customer_qualification" model="crm.stage"><field name="name">Qualification</field><field name="sequence">2</field><field name="team_ids" eval="[(4, ref('team_customer_requests'))]"/></record>
  <record id="stage_customer_info" model="crm.stage"><field name="name">Needs Customer Information</field><field name="sequence">3</field><field name="team_ids" eval="[(4, ref('team_customer_requests'))]"/></record>
  <record id="stage_customer_contacted" model="crm.stage"><field name="name">Customer Contacted</field><field name="sequence">4</field><field name="team_ids" eval="[(4, ref('team_customer_requests'))]"/></record>
  <record id="stage_customer_provider" model="crm.stage"><field name="name">Provider Coordination</field><field name="sequence">5</field><field name="team_ids" eval="[(4, ref('team_customer_requests'))]"/></record>
  <record id="stage_customer_appointment" model="crm.stage"><field name="name">Appointment Follow-Up</field><field name="sequence">6</field><field name="team_ids" eval="[(4, ref('team_customer_requests'))]"/></record>
  <record id="stage_customer_estimate" model="crm.stage"><field name="name">Estimate Follow-Up</field><field name="sequence">7</field><field name="team_ids" eval="[(4, ref('team_customer_requests'))]"/></record>
  <record id="stage_customer_decision" model="crm.stage"><field name="name">Customer Decision</field><field name="sequence">8</field><field name="team_ids" eval="[(4, ref('team_customer_requests'))]"/></record>
  <record id="stage_customer_post" model="crm.stage"><field name="name">Post-Service Follow-Up</field><field name="sequence">9</field><field name="team_ids" eval="[(4, ref('team_customer_requests'))]"/></record>
  <record id="stage_customer_converted" model="crm.stage"><field name="name">Converted / Booking Created</field><field name="sequence">10</field><field name="team_ids" eval="[(4, ref('team_customer_requests'))]"/><field name="is_won">True</field></record>
  <record id="stage_customer_cancelled" model="crm.stage"><field name="name">Closed — Cancelled</field><field name="sequence">11</field><field name="team_ids" eval="[(4, ref('team_customer_requests'))]"/><field name="fold">True</field></record>
  <record id="stage_customer_unserviceable" model="crm.stage"><field name="name">Closed — Unserviceable</field><field name="sequence">12</field><field name="team_ids" eval="[(4, ref('team_customer_requests'))]"/><field name="fold">True</field></record>
  <record id="stage_customer_lost" model="crm.stage"><field name="name">Closed — Lost</field><field name="sequence">13</field><field name="team_ids" eval="[(4, ref('team_customer_requests'))]"/><field name="fold">True</field></record>
  <record id="stage_provider_new" model="crm.stage"><field name="name">New Interest</field><field name="sequence">1</field><field name="team_ids" eval="[(4, ref('team_provider_recruitment'))]"/></record>
  <record id="stage_provider_review" model="crm.stage"><field name="name">Initial Review</field><field name="sequence">2</field><field name="team_ids" eval="[(4, ref('team_provider_recruitment'))]"/></record>
  <record id="stage_provider_info" model="crm.stage"><field name="name">Information Requested</field><field name="sequence">3</field><field name="team_ids" eval="[(4, ref('team_provider_recruitment'))]"/></record>
  <record id="stage_provider_docs" model="crm.stage"><field name="name">Documents Requested</field><field name="sequence">4</field><field name="team_ids" eval="[(4, ref('team_provider_recruitment'))]"/></record>
  <record id="stage_provider_qualification" model="crm.stage"><field name="name">Qualification Review</field><field name="sequence">5</field><field name="team_ids" eval="[(4, ref('team_provider_recruitment'))]"/></record>
  <record id="stage_provider_area" model="crm.stage"><field name="name">Service-Area Review</field><field name="sequence">6</field><field name="team_ids" eval="[(4, ref('team_provider_recruitment'))]"/></record>
  <record id="stage_provider_call" model="crm.stage"><field name="name">Interview / Call</field><field name="sequence">7</field><field name="team_ids" eval="[(4, ref('team_provider_recruitment'))]"/></record>
  <record id="stage_provider_approved" model="crm.stage"><field name="name">Approved for Onboarding</field><field name="sequence">8</field><field name="team_ids" eval="[(4, ref('team_provider_recruitment'))]"/></record>
  <record id="stage_provider_onboarding" model="crm.stage"><field name="name">Onboarding in Progress</field><field name="sequence">9</field><field name="team_ids" eval="[(4, ref('team_provider_recruitment'))]"/></record>
  <record id="stage_provider_onboarded" model="crm.stage"><field name="name">Onboarded</field><field name="sequence">10</field><field name="team_ids" eval="[(4, ref('team_provider_recruitment'))]"/><field name="is_won">True</field></record>
  <record id="stage_provider_rejected" model="crm.stage"><field name="name">Rejected</field><field name="sequence">11</field><field name="team_ids" eval="[(4, ref('team_provider_recruitment'))]"/><field name="fold">True</field></record>
  <record id="stage_provider_withdrawn" model="crm.stage"><field name="name">Withdrawn</field><field name="sequence">12</field><field name="team_ids" eval="[(4, ref('team_provider_recruitment'))]"/><field name="fold">True</field></record>
</odoo>
