<odoo>
 <record id="view_case_list" model="ir.ui.view"><field name="name">breero.crm.case.list</field><field name="model">breero.crm.case</field><field name="arch" type="xml"><list><field name="name"/><field name="case_type"/><field name="stage"/><field name="category"/><field name="team_id"/><field name="user_id"/></list></field></record>
 <record id="view_case_form" model="ir.ui.view"><field name="name">breero.crm.case.form</field><field name="model">breero.crm.case</field><field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="case_type"/><field name="external_reference"/><field name="stage"/><field name="team_id"/><field name="user_id"/></group><group string="Authoritative dispute mirrors" invisible="case_type != 'lead_dispute'"><field name="lead_id" readonly="1"/><field name="dispute_id" readonly="1"/><field name="provider_id" readonly="1"/><field name="dispute_status" readonly="1"/><field name="disputed_amount" readonly="1"/><field name="currency_id" readonly="1"/><field name="resolution_type" readonly="1"/><field name="resolution_reference" readonly="1"/></group><field name="message_text"/></sheet><chatter/></form></field></record>
 <record id="action_cases" model="ir.actions.act_window"><field name="name">CRM Cases</field><field name="res_model">breero.crm.case</field><field name="view_mode">list,form</field></record>
</odoo>
