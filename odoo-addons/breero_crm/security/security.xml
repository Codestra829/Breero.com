<odoo>
  <record id="module_category_breero" model="ir.module.category"><field name="name">BREERO</field><field name="sequence">40</field></record>
  <record id="privilege_breero" model="res.groups.privilege"><field name="name">BREERO</field><field name="sequence">40</field><field name="category_id" ref="module_category_breero"/></record>
  <record id="group_breero_crm_agent" model="res.groups"><field name="name">BREERO CRM Agent</field><field name="privilege_id" ref="privilege_breero"/><field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/></record>
  <record id="group_breero_crm_manager" model="res.groups"><field name="name">BREERO CRM Manager</field><field name="privilege_id" ref="privilege_breero"/><field name="implied_ids" eval="[(4, ref('group_breero_crm_agent'))]"/></record>
  <record id="group_breero_support" model="res.groups"><field name="name">BREERO Support Agent</field><field name="privilege_id" ref="privilege_breero"/></record>
  <record id="group_breero_provider_recruitment" model="res.groups"><field name="name">BREERO Provider Recruitment</field><field name="privilege_id" ref="privilege_breero"/></record>
  <record id="group_breero_dispute_reviewer" model="res.groups"><field name="name">BREERO Lead Dispute Reviewer</field><field name="privilege_id" ref="privilege_breero"/></record>
  <record id="group_breero_integration" model="res.groups"><field name="name">BREERO Integration Service</field><field name="privilege_id" ref="privilege_breero"/><field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/></record>
  <record id="rule_case_support" model="ir.rule"><field name="name">Support cases only</field><field name="model_id" ref="model_breero_crm_case"/><field name="groups" eval="[(4, ref('group_breero_support'))]"/><field name="domain_force">[('case_type','=','support')]</field></record>
  <record id="rule_case_disputes" model="ir.rule"><field name="name">Dispute cases only</field><field name="model_id" ref="model_breero_crm_case"/><field name="groups" eval="[(4, ref('group_breero_dispute_reviewer'))]"/><field name="domain_force">[('case_type','=','lead_dispute')]</field></record>
  <record id="rule_lead_provider" model="ir.rule"><field name="name">Provider recruitment leads only</field><field name="model_id" ref="crm.model_crm_lead"/><field name="groups" eval="[(4, ref('group_breero_provider_recruitment'))]"/><field name="domain_force" eval="[('team_id','=',ref('breero_crm.team_provider_recruitment'))]"/></record>
</odoo>
