# Copy to a secret-managed path; never commit populated values.
APP_ENV=staging
POSTGRES_DB=breero_staging
POSTGRES_USER=breero_staging
POSTGRES_PASSWORD=replace-with-random-value
DATABASE_URL=postgresql+psycopg://breero_staging:replace-with-url-encoded-value@postgres:5432/breero_staging
REDIS_PASSWORD=replace-with-random-value
REDIS_URL=redis://:replace-with-url-encoded-value@redis:6379/0
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
CORS_ORIGINS=https://staging.breero.com
STRIPE_SECRET_KEY=replace-with-stripe-test-secret
STRIPE_WEBHOOK_SECRET=replace-with-stripe-test-webhook-secret
GEOCODING_API_KEY=replace-with-test-key
GEOCODING_PROVIDER=geoapify
ODOO_URL=replace-with-test-url
ODOO_DATABASE=replace-with-test-db
ODOO_USERNAME=replace-with-test-user
ODOO_API_KEY=replace-with-test-key
SMTP_HOST=replace-with-sandbox-host
SMTP_PORT=587
SMTP_USERNAME=replace-with-sandbox-user
SMTP_PASSWORD=replace-with-sandbox-password
SMTP_FROM_EMAIL=uat@staging.breero.com
SMS_PROVIDER=fake
SMS_API_KEY=test-only
PAYOUT_PROVIDER=fake
PAYOUT_API_KEY=test-only
