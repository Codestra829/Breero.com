APP_ENV=production
DATABASE_URL=postgresql+psycopg://breero_prod:CHANGE_ME@breero-prod-postgres:5432/breero_prod
REDIS_URL=redis://:CHANGE_ME@breero-prod-redis:6379/0
JWT_SECRET=CHANGE_ME_MINIMUM_32_CHARACTERS
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_MINIMUM_32_CHARACTERS
CORS_ORIGINS=https://breero.com,https://www.breero.com
STRIPE_ENABLED=false
GEOCODING_ENABLED=false
EMAIL_ENABLED=false
SMS_ENABLED=false
ODOO_ENABLED=false
MIDDLEWARE_ENABLED=false
MIDDLEWARE_URL=https://middleware.internal.codestra.agency
MIDDLEWARE_CA_FILE=/run/secrets/codestra_private_ca.pem
MIDDLEWARE_HMAC_KEY_ID=CHANGE_ME
MIDDLEWARE_HMAC_SECRET_FILE=/run/secrets/breero_middleware_hmac
MIDDLEWARE_SERVICE_IDENTITY=breero-production
MIDDLEWARE_AUDIENCE=codestra-middleware-breero
MIDDLEWARE_TENANT=breero
MIDDLEWARE_SCOPE=breero.crm.events.submit
PAYOUT_ENABLED=false
